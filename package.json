{
  "name": "antora-tracer",
  "version": "0.7.0",
  "type": "module",
  "description": "Requirements traceability extensions for Antora/AsciiDoc",
  "main": "./lib/src/index.js",
  "module": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./antora-extension": "./lib/src/antora-extension.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "test": "tsc -p tsconfig.test.json && node --import=tsx/cjs 'node_modules/mocha/bin/mocha' 'lib/test/**/*.test.js'",
    "test:coverage": "npm run build && rm -rf .nyc_output coverage && c8 --all --include='lib/src/**/*.js' --exclude='lib/src/test/**' --exclude='lib/src/coverage/**' node --import=tsx/cjs node_modules/mocha/bin/mocha 'lib/test/**/*.test.js'",
    "test:coverage:report": "c8 report",
    "test:coverage:check": "c8 check-coverage --lines 50 --branches 50 --functions 50 --statements 50",
    "test:coverage:open": "c8 report --reporter=html",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "start": "node lib/cli.js",
    "dev": "nodemon --watch src --exec \"npm run build && node lib/index.js\"",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch"
  },
  "keywords": [
    "antora",
    "asciidoc",
    "requirements",
    "traceability",
    "documentation"
  ],
  "author": "Richard",
  "license": "MIT",
  "dependencies": {
    "@asciidoctor/core": "^2.2.7",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.1",
    "asciidoctor-kroki": "^0.18.1",
    "biome": "^0.3.3",
    "c8": "^12.0.0",
    "chai": "^5.1.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "mocha": "^10.4.0",
    "nyc": "^18.0.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "antora-req-trace": "./lib/cli.js"
  },
  "files": [
    "lib",
    "!lib/test",
    "!lib/src/test",
    "!lib/coverage",
    "!lib/src/coverage",
    "package.json",
    "README.adoc",
    "LICENSE"
  ]
}
