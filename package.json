{
  "name": "antora-tracer",
  "version": "0.18.0",
  "type": "module",
  "description": "Requirements traceability extensions for Antora/AsciiDoc",
  "main": "./lib/src/index.js",
  "module": "lib/src/index.js",
  "exports": {
    ".": "./lib/src/index.js",
    "./antora-extension": "./lib/src/antora-extension.js",
    "./antora-pdf": "./lib/src/antora-pdf-extension.cjs",
    "./antora-docx": "./lib/src/antora-docx-extension.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "test": "tsc -p tsconfig.test.json && node scripts/build.js && node --import=tsx/cjs 'node_modules/mocha/bin/mocha' 'lib/test/**/*.test.js'",
    "test:coverage": "npm run build && rm -rf .nyc_output coverage && c8 --include='lib/src/**/*.js' --exclude='lib/src/test/**' --exclude='lib/src/coverage/**' --exclude='lib/src/cli.js' node --import=tsx/cjs node_modules/mocha/bin/mocha 'lib/test/**/*.test.js'",
    "test:coverage:report": "c8 report",
    "test:coverage:check": "c8 check-coverage --lines 80 --branches 70 --functions 80 --statements 80",
    "test:coverage:open": "c8 report --reporter=html",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "preview": "node scripts/preview.js",
    "start": "node lib/src/cli.js",
    "dev": "nodemon --watch src --exec \"npm run build && node lib/src/index.js\"",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch"
  },
  "keywords": [
    "antora",
    "asciidoc",
    "requirements",
    "traceability",
    "documentation"
  ],
  "author": "Richard Attermeyer",
  "license": "MIT",
  "dependencies": {
    "@asciidoctor/core": "^2.2.7",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@antora/assembler": "1.0.0-beta.20",
    "@antora/cli": "3.1",
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "@antora/pdf-extension": "1.0.0-beta.20",
    "@antora/site-generator": "3.1",
    "@biomejs/biome": "^2.5.5",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.1",
    "asciidoctor-kroki": "^0.18.1",
    "c8": "^12.0.0",
    "chai": "^5.1.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "downdoc": "^1.1.0-stable",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "patch-package": "^8.0.1",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@antora/assembler": "1.0.0-beta.20",
    "@antora/pdf-extension": "1.0.0-beta.20"
  },
  "peerDependenciesMeta": {
    "@antora/assembler": {
      "optional": true
    },
    "@antora/pdf-extension": {
      "optional": true
    }
  },
  "bin": {
    "antora-tracer": "lib/src/cli.js"
  },
  "files": [
    "lib/src",
    "!lib/src/test",
    "!lib/src/coverage",
    "skills",
    "package.json",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rattermeyer/antora-tracer.git"
  },
  "bugs": {
    "url": "https://github.com/rattermeyer/antora-tracer/issues"
  },
  "homepage": "https://antora-tracer.conemso.de"
}
