@startuml
' Public API — class structure and key method groups
' Grouped by package: Core, Configuration, Output, Antora Integration
' Full method signatures: see API reference

skinparam classBackgroundColor #F8F9FA
skinparam classBorderColor #888888
skinparam packageBackgroundColor #FAFAFA

package "Core" #E3F2FD {
  class TraceabilityGraph {
    population: addItem(), addRelationship()
    query: getItemsByRole(), getRelationships(), getReverseRelationships()
    analysis: findPath(), getImpactAnalysis(), validate()
    serialization: toDot(), toVegaLite()
  }

  class DocumentParser {
    + parse(content, sourceFile?, component?, module?): ParserResult
    + checkForOldMacros(content): OldMacroError[]
  }

  class RequirementsTraceabilityExtension {
    factory: {static} createWithPreset(name)
    processing: process(), processFiles()
    access: graph, configLoader
  }
}

package "Configuration" #FFF3E0 {
  class ConfigLoader {
    loading: load(), loadPreset(), listPresets()
    validation: isKnownRole(), isRelationAllowed()
    queries: getMatrices(), getNeo4jQueries()
  }
}

package "Output" #E8EAF6 {
  class MatrixGenerator {
    generation: generateMatrix()
    export: exportToHTML(), exportToCSV()
    statistics: getCoverageReport(), getRelationshipStatistics()
  }

  class TemplateRenderer {
    + render(templateName, data): string
  }

  class LinkResolver {
    + generateItemLink(item): string | null
    + generateRowLink(item): string | null
  }

  class Neo4jExporter {
    + export(options): ExportResult
  }
}

package "Antora Integration" #E8F5E9 {
  class AntoraTraceabilityExtension {
    registration: registerContentClassifier(), registerPageProcessor()
    processing: prepareFile(), expandRelationMacros(), substituteLinksInFile()
    visualization: expandGraphMacros(), expandCoverageMacros()
  }
}

' Dependencies
RequirementsTraceabilityExtension --> TraceabilityGraph : owns
RequirementsTraceabilityExtension --> DocumentParser : delegates
RequirementsTraceabilityExtension --> ConfigLoader : loads
RequirementsTraceabilityExtension --> MatrixGenerator : delegates
RequirementsTraceabilityExtension --> Neo4jExporter : delegates
AntoraTraceabilityExtension --> RequirementsTraceabilityExtension : orchestrates
MatrixGenerator --> TemplateRenderer : renders HTML
MatrixGenerator --> LinkResolver : resolves links
ConfigLoader --> TraceabilityGraph : provides validation rules

note bottom of TraceabilityGraph
  Query methods are read-only after Pass 1.
  addItem() and addRelationship() are only
  called during graph population.
end note

@enduml
