@startuml
' High-level Antora build flow — internal pass detail in pass-pipeline.puml

actor "Antora Build" as antora
participant "AntoraTraceabilityExtension" as antora_ext
participant "RequirementsTraceabilityExtension" as main_ext
participant "TraceabilityGraph" as graph
participant "MatrixGenerator" as matrix
participant "Neo4jExporter" as neo4j

== Initialization ==
antora -> antora_ext : register(context)
antora_ext -> antora_ext : loadConfig() from playbook
antora_ext -> main_ext : createWithPreset() or createWithConfig()

== contentClassified — parse, expand, substitute ==
antora -> antora_ext : contentClassified event

loop for each .adoc file
  antora_ext -> main_ext : process(content, sourceFile)
  main_ext -> graph : add items + relationships
  graph -> graph : validate (config rules)
end

loop for each page file
  antora_ext -> graph : query relationships (outgoing, incoming)
  antora_ext -> antora_ext : expand traceability:links[] / graph[] macros
  antora_ext -> antora_ext : substitute addresses:ID[] → xref / link
end

note right
  Three internal passes — Pass 1 populates the graph,
  Pass 2 expands rendering and visualization macros,
  Pass 3 replaces inline relationship markers with
  Asciidoctor xrefs/link macros.
  See pass-pipeline diagram for full detail.
end note

== sitePublished — generate matrices + export ==
antora -> antora_ext : sitePublished event

loop for each matrix definition
  antora_ext -> matrix : generateMatrix(name)
  matrix -> graph : query items, relationships, coverage
  matrix --> antora_ext : HTML + CSV output
end

antora_ext -> neo4j : export({ outputDir, format })
neo4j -> graph : getAllItems(), getAllRelationships()
neo4j --> antora_ext : nodes.csv, relationships.csv, import.cypher

@enduml
