@startuml C4_Container
!NEW_C4_STYLE=1
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Antora Tracer — Containers

Person(author, "Documentation author")
Person(maintainer, "Project maintainer")
System_Ext(antora, "Antora", "Documentation site generator")
System_Ext(aiAssistant, "AI assistant", "External agent that can use skill files")
System_Ext(neo4j, "Neo4j", "Optional graph database")
System_Ext(kroki, "Kroki", "Optional diagram and chart renderer")

System_Boundary(tracer, "Antora Tracer") {
  Container(core, "Core package", "TypeScript / Node.js", "CLI, Antora extension entry point, and shared traceability API")
  Container(skills, "Agent skill bundle", "Markdown / Agent Skills", "Optional authoring and review instructions distributed with the package")
  Container(idServer, "ID allocation server", "Node.js HTTP service", "Optional companion service for shared sequential IDs")
  ContainerDb(allocatorDb, "Allocator state", "SQLite", "Persists counters and hashed project tokens")
}

Rel(author, core, "Runs CLI and authors traceable AsciiDoc")
Rel(antora, core, "Loads extension inside the build process")
Rel(maintainer, skills, "Installs selected skills")
Rel(aiAssistant, skills, "Loads and follows instructions")
Rel(core, idServer, "Requests IDs when remote allocation is configured", "HTTP")
Rel(idServer, allocatorDb, "Reads and writes counters and projects")
Rel(core, neo4j, "Produces optional CSV / Cypher import files")
Rel(core, kroki, "Produces optional visualization references")

@enduml
