@startuml
' Configuration resolution chain — preset → merge → validation queries

skinparam componentBackgroundColor #F8F9FA

database "Built-in\nPresets\n(requirements-engineering,\nmedical-iec62304, agile, minimal)" as presets

file "User\nConfig\n(traceability.yml)" as userconfig

[ConfigLoader] as loader

rectangle "Resolved Configuration\n(memoized merge result)" as resolved {
  [roles] as roles
  [relations\nsource→target→[types]] as relations
  [matrices\nrow × column definitions] as matrices
  [neo4j.queries\nnamed Cypher queries] as queries
}

' Consumers
[DocumentParser] as parser
[TraceabilityGraph] as graph
[MatrixGenerator] as matrixgen
[Neo4jExporter] as neo4j

' Merge flow
presets --> loader : load preset YAML
userconfig --> loader : load + deep-merge overrides
loader --> resolved : memoized merge

' Consumers query resolved config
roles --> parser : isKnownRole()
roles --> graph : getItemsByRole()
relations --> graph : isRelationAllowed()\n(both directions)
matrices --> matrixgen : getMatrices()
queries --> neo4j : getNeo4jQueries()

note bottom of resolved
  Config resolution is lazy — the first
  consumer triggers the merge. Result is
  memoized and reused by all consumers.
end note

@enduml
