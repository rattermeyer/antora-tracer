{
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string" },
          "relation": { "type": "string" },
          "target_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "problem": { "type": "string" },
          "suggestion": { "type": "string" }
        },
        "required": [
          "source_id",
          "relation",
          "target_id",
          "severity",
          "confidence",
          "problem",
          "suggestion"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["none", "offer", "declined", "needs_path", "warn", "create"]
        },
        "path": { "type": ["string", "null"] },
        "content": { "type": ["string", "null"] }
      },
      "required": ["decision", "path", "content"],
      "additionalProperties": false
    }
  },
  "required": ["summary", "findings", "report"],
  "additionalProperties": false
}
