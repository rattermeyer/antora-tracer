    <div class="summary">
      <h2>Coverage Summary</h2>
      <table>
        <tr><td>Total {{summary.itemType}}</td><td><strong>{{summary.total}}</strong></td></tr>
        {{#summary.withImplementation}}
        <tr><td>{{summary.itemType}} with Implementation</td><td><strong>{{summary.withImplementation}}</strong></td></tr>
        {{/summary.withImplementation}}
        {{#summary.withTests}}
        <tr><td>{{summary.itemType}} with Tests</td><td><strong>{{summary.withTests}}</strong></td></tr>
        {{/summary.withTests}}
        <tr><td>Implementation Coverage</td><td><strong>{{summary.implCoverage}}%</strong></td></tr>
        <tr><td>Test Coverage</td><td><strong>{{summary.testCoverage}}%</strong></td></tr>
      </table>
    </div>
