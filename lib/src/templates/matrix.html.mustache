<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{name}} - Traceability Matrix</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 20px;
            line-height: 1.6;
        }
        h1, h2, h3 { color: #333; }
        .matrix-container { overflow-x: auto; margin: 20px 0; }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px 12px;
            text-align: left;
        }
        th {
            background-color: #4a5568;
            color: white;
            font-weight: 600;
        }
        tr:nth-child(even) { background-color: #f8f9fa; }
        tr:hover { background-color: #e9ecef; }

        /* Role-specific styling */
        .role-requirement { background-color: #fff5f5; }
        .role-design { background-color: #f0fff4; }
        .role-implementation { background-color: #f0f8ff; }
        .role-test { background-color: #fffaf0; }
        .role-document { background-color: #f8f9fa; }

        /* Status styling */
        .status-complete { background-color: #d6f5d6; }
        .status-partial { background-color: #fff9db; }
        .status-missing { background-color: #ffdbdb; }

        .coverage-summary {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 20px 0;
        }
        .coverage-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .coverage-complete { background-color: #22c55e; color: white; }
        .coverage-partial { background-color: #f59e0b; color: white; }
        .coverage-missing { background-color: #ef4444; color: white; }
        .coverage-low { background-color: #f97316; color: white; }

        .metadata {
            color: #666;
            font-size: 14px;
            margin: 10px 0;
        }
        .empty-cell { color: #999; font-style: italic; }
    </style>
</head>
<body>
    <h1>{{name}}</h1>
    <p class="metadata">Type: {{type}} | Generated: {{generatedAt}}</p>

    {{#coverage}}
    <div class="coverage-summary">
        <h3>Coverage Summary</h3>
        <p>
            <span class="coverage-badge coverage-complete">Complete: {{complete}} / {{total}}</span>
            <span class="coverage-badge coverage-partial">Partial: {{partial}}</span>
            <span class="coverage-badge coverage-missing">Missing: {{missing}}</span>
            <br>
            <strong>Overall Coverage: {{overallFormatted}}%</strong>
        </p>
    </div>
    {{/coverage}}

    <div class="matrix-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    {{#columns}}
                    <th>{{name}}<br><small>{{role}}</small></th>
                    {{/columns}}
                    <th>Coverage</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr class="status-{{status}} role-{{rowRole}}">
                    <td>{{rowId}}</td>
                    <td>{{rowTitle}}</td>
                    {{#cells}}
                    <td{{#hasItems}} class="role-{{role}}"{{/hasItems}}>
                        {{#hasItems}}
                            {{#items}}
                            <div><strong>{{itemId}}</strong>: {{itemTitle}}</div>
                            {{/items}}
                        {{/hasItems}}
                        {{^hasItems}}
                            <span class="empty-cell">-</span>
                        {{/hasItems}}
                    </td>
                    {{/cells}}
                    <td>{{coverageFormatted}}%</td>
                    <td><span class="coverage-badge coverage-{{status}}">{{status}}</span></td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>

    <footer class="metadata">
        <p>Generated by Antora Requirements Traceability Extension v2.0</p>
    </footer>
</body>
</html>
