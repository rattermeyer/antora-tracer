{{> header}}

    {{#coverage}}
    <div class="coverage-summary">
        <h3>Coverage Summary</h3>
        <p>
            <span class="coverage-badge coverage-done">Done: {{done}} / {{total}}</span>
            <span class="coverage-badge coverage-partial">Partial: {{partial}}</span>
            <span class="coverage-badge coverage-missing">Missing: {{missing}}</span>
            <br>
            <strong>Overall Coverage: {{overallFormatted}}%</strong>
        </p>
    </div>
    {{/coverage}}

    <div class="matrix-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    {{#columns}}
                    <th>{{name}}<br><small>{{role}}</small></th>
                    {{/columns}}
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                {{> matrix-row}}
                {{/rows}}
            </tbody>
        </table>
    </div>

{{> footer}}
