        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 20px;
            line-height: 1.6;
        }
        h1, h2, h3 { color: #333; }
        .matrix-container { overflow-x: auto; margin: 20px 0; }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px 12px;
            text-align: left;
        }
        th {
            background-color: #4a5568;
            color: white;
            font-weight: 600;
        }
        tr:nth-child(even) { background-color: #f8f9fa; }
        tr:hover { background-color: #e9ecef; }

        /* Role-specific styling */
        .role-requirement { background-color: #fff5f5; }
        .role-design { background-color: #f0fff4; }
        .role-implementation { background-color: #f0f8ff; }
        .role-test { background-color: #fffaf0; }
        .role-document { background-color: #f8f9fa; }

        /* Status styling */
        .status-done { background-color: #d6f5d6; }
        .status-partial { background-color: #fff9db; }
        .status-missing { background-color: #ffdbdb; }

        .coverage-summary {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 20px 0;
        }
        .coverage-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        .coverage-done { background-color: #22c55e; color: white; }
        .coverage-partial { background-color: #f59e0b; color: white; }
        .coverage-missing { background-color: #ef4444; color: white; }
        .coverage-low { background-color: #f97316; color: white; }

        .metadata {
            color: #666;
            font-size: 14px;
            margin: 10px 0;
        }
        .empty-cell { color: #999; font-style: italic; }

        /* Item link styling */
        .matrix-container a {
            color: inherit;
            text-decoration: none;
        }
        .matrix-container a:hover {
            text-decoration: underline;
        }
        .source-ref {
            color: #666;
            font-size: 0.85em;
            margin-left: 0.5em;
        }
